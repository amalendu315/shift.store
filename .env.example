# Node 22.13+ required. SQLite is created automatically inside DATA_DIR.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Set to the exact HTTPS origin when deploying behind a reverse proxy.
# APP_ORIGIN=https://your-store.example

# Used only to create the first administrator on an empty database.
ADMIN_EMAIL=admin@shiftstore.local
# Optional: at least 12 characters. If omitted, a random password is generated.
ADMIN_DEFAULT_PASSWORD=
# Initial credentials are saved locally to data/bootstrap-admin.txt (mode 0600).
# Cashfree keys are server-only. Use sandbox while testing.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Public HTTPS webhook URL for deployed environments:
# CASHFREE_NOTIFY_URL=https://your-store.example/api/payments/webhook/cashfree
